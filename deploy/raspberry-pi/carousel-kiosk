#!/usr/bin/env bash
set -u

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

# Autostart and SSH may begin from a directory inaccessible to this user.
# Ensure Chromium and helper processes inherit the kiosk account home.
cd "$HOME" || { echo "Cannot enter kiosk home: $HOME" >&2; exit 1; }

CONF="$HOME/.config/lyrion-carousel/kiosk.conf"
if [[ ! -f "$CONF" ]]; then
  echo "Missing kiosk configuration: $CONF" >&2
  exit 1
fi
# Configuration belongs to the desktop user. Do not run the kiosk as root.
# shellcheck disable=SC1090
source "$CONF"
: "${CAROUSEL_URL:=http://127.0.0.1:8088/}"
: "${RECONNECT_INTERVAL:=5}"
: "${HEALTH_INTERVAL:=10}"
: "${HEALTH_FAILURES:=3}"
: "${HIDE_CURSOR:=true}"
: "${DISABLE_SCREEN_BLANKING:=true}"

case "$CAROUSEL_URL" in http://*|https://*) ;; *) echo "Invalid CAROUSEL_URL" >&2; exit 2;; esac
for n in RECONNECT_INTERVAL HEALTH_INTERVAL HEALTH_FAILURES; do
  v="${!n}"
  [[ "$v" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid $n" >&2; exit 2; }
done
command -v chromium >/dev/null || { echo "Chromium is not installed" >&2; exit 2; }
command -v curl >/dev/null || { echo "curl is not installed" >&2; exit 2; }

LOG_DIR="$HOME/.local/state/lyrion-carousel-kiosk"
mkdir -p "$LOG_DIR"
# One Chromium supervisor per desktop user/profile. The file descriptor stays
# open for the whole supervisor lifetime; do not remove the lock file.
exec 9>"$LOG_DIR/supervisor.lock"
if ! flock -n 9; then
  echo "Lyrion Carousel kiosk supervisor is already running for this user" >&2
  exit 0
fi
LOG="$LOG_DIR/chromium.log"
if [[ -f "$LOG" ]] && (( $(stat -c %s "$LOG") > 5242880 )); then
  mv "$LOG" "$LOG.1"
fi
log() { printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"; }
healthy() { curl -fLsS --connect-timeout 3 --max-time 5 -o /dev/null "$CAROUSEL_URL" 2>/dev/null; }

# Keep default mode discovery for monitors including the 2560x720 Corsair EDGE.
if [[ "$DISABLE_SCREEN_BLANKING" == true ]] && command -v wlr-randr >/dev/null; then
  log "Display mode remains auto; screen blanking should be configured by the desktop"
fi
args=(--ozone-platform=wayland --kiosk --no-first-run --no-default-browser-check
      --noerrdialogs --disable-session-crashed-bubble
      --overscroll-history-navigation=0
      "--user-data-dir=$HOME/.config/carousel-chromium")
if [[ "$HIDE_CURSOR" == true ]]; then
  # Chromium's kiosk mode does not itself hide the cursor; see labwc configuration in docs.
  log "Cursor hiding is controlled by labwc/swayidle, not Chromium"
fi

browser_pid=""
cleanup() {
  trap - INT TERM EXIT
  if [[ -n "$browser_pid" ]] && kill -0 "$browser_pid" 2>/dev/null; then
    kill "$browser_pid" 2>/dev/null || true
    wait "$browser_pid" 2>/dev/null || true
  fi
}
trap cleanup INT TERM EXIT
log "Kiosk supervisor started"
while :; do
  until healthy; do
    log "Waiting for Carousel at $CAROUSEL_URL"
    sleep "$RECONNECT_INTERVAL"
  done
  log "Starting Chromium"
  chromium "${args[@]}" "$CAROUSEL_URL" >> "$LOG" 2>&1 &
  browser_pid=$!
  failures=0
  while kill -0 "$browser_pid" 2>/dev/null; do
    sleep "$HEALTH_INTERVAL"
    if healthy; then
      failures=0
    else
      failures=$((failures + 1))
      log "Carousel health-check failure $failures/$HEALTH_FAILURES"
      if (( failures >= HEALTH_FAILURES )); then
        log "Server unavailable; restarting browser once it returns"
        kill "$browser_pid" 2>/dev/null || true
        break
      fi
    fi
  done
  wait "$browser_pid" 2>/dev/null
  rc=$?
  browser_pid=""
  log "Chromium exited (status $rc)"
  sleep "$RECONNECT_INTERVAL"
done
