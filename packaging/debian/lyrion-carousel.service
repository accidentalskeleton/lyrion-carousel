[Unit]
Description=Lyrion Carousel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=LMS_URL=http://mrlazy:9000
Environment=BIND_ADDRESS=0.0.0.0
Environment=PORT=8088
Environment=CACHE_DIR=/var/cache/lyrion-carousel/artwork
Environment=BATCH_SIZE=40
Environment=IDLE_RETURN_SECONDS=30
Environment=RECONNECT_MAX_SECONDS=30
Environment=RANDOM_SCROLL_MAX_SECONDS=3
Environment=SEARCH_LIMIT=100
Environment=CACHE_LIMIT_MB=512
Environment=CACHE_HARD_LIMIT_MB=2000
EnvironmentFile=-/etc/default/lyrion-carousel
ExecStart=/usr/bin/python3 /opt/lyrion-carousel/server.py --lms ${LMS_URL} --bind ${BIND_ADDRESS} --port ${PORT} --cache-dir ${CACHE_DIR} --cache-limit-mb ${CACHE_LIMIT_MB} --cache-hard-limit-mb ${CACHE_HARD_LIMIT_MB} --batch-size ${BATCH_SIZE} --idle-return-seconds ${IDLE_RETURN_SECONDS} --reconnect-max-seconds ${RECONNECT_MAX_SECONDS} --random-scroll-max-seconds ${RANDOM_SCROLL_MAX_SECONDS} --search-limit ${SEARCH_LIMIT}
WorkingDirectory=/opt/lyrion-carousel
DynamicUser=yes
CacheDirectory=lyrion-carousel
CacheDirectoryMode=0750
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0027

[Install]
WantedBy=multi-user.target
