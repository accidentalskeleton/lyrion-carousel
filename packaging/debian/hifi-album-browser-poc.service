[Unit]
Description=Hi-fi Lyrion album browser POC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=LMS_URL=http://mrlazy:9000
Environment=BIND_ADDRESS=0.0.0.0
Environment=PORT=8088
Environment=CACHE_DIR=/var/cache/hifi-album-browser-poc/artwork
Environment=BATCH_SIZE=40
Environment=IDLE_RETURN_SECONDS=30
Environment=LIBRARY_CHECK_SECONDS=30
Environment=STATUS_POLL_SECONDS=2
Environment=RECONNECT_MAX_SECONDS=30
Environment=RANDOM_SCROLL_MAX_SECONDS=3
Environment=SEARCH_LIMIT=100
EnvironmentFile=-/etc/default/hifi-album-browser-poc
ExecStart=/usr/bin/python3 /opt/hifi-album-browser-poc/server.py --lms ${LMS_URL} --bind ${BIND_ADDRESS} --port ${PORT} --cache-dir ${CACHE_DIR} --batch-size ${BATCH_SIZE} --idle-return-seconds ${IDLE_RETURN_SECONDS} --library-check-seconds ${LIBRARY_CHECK_SECONDS} --status-poll-seconds ${STATUS_POLL_SECONDS} --reconnect-max-seconds ${RECONNECT_MAX_SECONDS} --random-scroll-max-seconds ${RANDOM_SCROLL_MAX_SECONDS} --search-limit ${SEARCH_LIMIT}
WorkingDirectory=/opt/hifi-album-browser-poc
DynamicUser=yes
CacheDirectory=hifi-album-browser-poc
CacheDirectoryMode=0750
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0027

[Install]
WantedBy=multi-user.target
