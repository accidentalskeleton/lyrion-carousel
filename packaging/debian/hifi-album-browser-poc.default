# Lyrion Music Server used by the album browser.
LMS_URL=http://mrlazy:9000

# Listen on the LAN. Use 127.0.0.1 for local access only.
BIND_ADDRESS=0.0.0.0
PORT=8088

# Persistent cache owned automatically by the systemd service.
CACHE_DIR=/var/cache/hifi-album-browser-poc/artwork

# Albums requested from LMS per catalogue batch.
BATCH_SIZE=40

# Seconds without interaction before returning to the playing album. 0 disables.
IDLE_RETURN_SECONDS=30

# Seconds between LMS library checks. 0 disables.
LIBRARY_CHECK_SECONDS=30

# Seconds between playback-status requests.
STATUS_POLL_SECONDS=2

# Maximum exponential reconnect delay in seconds.
RECONNECT_MAX_SECONDS=30

# Maximum shamrock scroll duration in seconds.
RANDOM_SCROLL_MAX_SECONDS=3

# Maximum albums returned by a text search.
SEARCH_LIMIT=100
